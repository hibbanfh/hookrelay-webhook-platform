# Hookrelay configuration. Mirrors docs/architecture.md section 14.
# Local: `cp .env.example .env` is optional, docker-compose.yml has development defaults.
# Production: set these as Fly secrets / GitHub Actions secrets. NEVER commit real values.

# --- Backend (all processes) -------------------------------------------------------
# development | production. production enforces https and blocks private destinations.
APP_ENV=development
# API listen address.
HTTP_ADDR=:8080
# Required. pgx DSN. (docker compose sets this itself for the in-network postgres.)
DATABASE_URL=postgres://hookrelay:hookrelay@localhost:5432/hookrelay?sslmode=disable
# debug | info | warn | error
LOG_LEVEL=info
# Public URL of the API. Must be https:// when APP_ENV=production.
PUBLIC_BASE_URL=http://localhost:8080
# POST /v1/projects returns 403 when false. Default: true in development, false in production.
PROJECT_CREATION_ENABLED=true
# Required. base64 of exactly 32 bytes. Generate: openssl rand -base64 32
# This development value is public; do not use it anywhere real.
SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Optional. Previous key during rotation (decrypt only).
SECRET_ENCRYPTION_KEY_PREVIOUS=
MAX_ENDPOINTS_PER_PROJECT=20
# Request body limit in bytes (256 KB).
MAX_BODY_BYTES=262144
IDEMPOTENCY_TTL=24h

# --- Delivery / worker -------------------------------------------------------------
# Per-attempt HTTP timeout.
DELIVERY_TIMEOUT=10s
# Comma-separated Go durations. Max attempts = entries + 1.
RETRY_SCHEDULE=5s,30s,2m,15m,1h
# 0 <= jitter < 1
RETRY_JITTER=0.10
WORKER_CONCURRENCY=16
WORKER_POLL_INTERVAL=500ms
# Must be greater than DELIVERY_TIMEOUT + 5s (validated at startup).
WORKER_LEASE_DURATION=30s
# Keep below the Fly kill_timeout (30s).
WORKER_SHUTDOWN_TIMEOUT=25s
# Private worker health endpoint.
WORKER_HEALTH_ADDR=:9091

# --- Demo receiver / SSRF ----------------------------------------------------------
DEMO_RECEIVER_ENABLED=true
# Must be reachable from the worker. Compose: http://api:8080/demo/receiver
# Default when empty: {PUBLIC_BASE_URL}/demo/receiver
DEMO_RECEIVER_BASE_URL=
# Comma-separated URL prefixes exempt from production SSRF rules. Default: DEMO_RECEIVER_BASE_URL
OUTBOUND_ALLOWLIST=
# true = only allowlisted destinations may be registered (public demo hardening).
OUTBOUND_ALLOWLIST_ONLY=false

# --- Seed --------------------------------------------------------------------------
# Required for `hookrelay seed`: "hr_" + 43 base64url characters. Public for the demo, so never reuse.
SEED_DEMO_API_KEY=hr_demo_key_local_only_not_a_real_secret_00000
SEED_DEMO_PROJECT_NAME=Hookrelay Demo

# --- Frontend (Next.js BFF) --------------------------------------------------------
# Where the BFF proxies /api/v1/*. Compose: http://api:8080
API_INTERNAL_URL=http://localhost:8080
# Cookie encryption secret, at least 32 bytes. Generate: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-0123456789

# Web only: set to 1 to run a production build over plain http (local docker compose). Otherwise the
# server refuses to start with NODE_ENV=production and a non-https DASHBOARD_ORIGIN.
ALLOW_INSECURE_SESSION_COOKIE=

# --- Neon Auth (managed Better Auth) -----------------------------------------------
# Base URL of the Neon Auth endpoint (not a secret). Endpoints: /sign-up/email, /sign-in/email, /get-session.
# Leave empty for development without Neon. Real value looks like:
#   https://ep-<id>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
# Name of Neon's session cookie (confirmed against the real service). Go sends it when it verifies a
# session; the BFF reads it from Neon's Set-Cookie. The __Secure- prefix is part of the name.
NEON_AUTH_SESSION_COOKIE=__Secure-neon-auth.session_token
# The browser origin of the dashboard (scheme://host[:port], no path). Sent as the Origin header to
# Neon, so it must be on Neon's trusted origins list. Required when NEON_AUTH_BASE_URL is set.
DASHBOARD_ORIGIN=http://localhost:3000
# Go API only: timeout of the get-session call (must be < 10s) and how long a verified session is
# cached (0-60s, 0 = off). A signed-out session can keep working for up to this long.
NEON_AUTH_TIMEOUT=3s
SESSION_CACHE_TTL=5s
# Leave NEON_AUTH_BASE_URL empty in development to run without Neon: every dashboard session is
# rejected, API keys keep working. In production it is required and must be https.
